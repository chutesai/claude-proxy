# Claude Proxy Configuration
HOST_PORT=8181
BACKEND_URL=https://llm.chutes.ai/v1/chat/completions
# Optional: override the Host header sent to the backend (useful for internal k8s routing)
# BACKEND_HOST_HEADER=llm.chutes.ai
RUST_LOG=info

# Caddy Configuration
CADDY_PORT=443
CADDY_TLS=true

# Caddy Domain (optional - if set, enables automatic HTTPS)
CADDY_DOMAIN=claude.chutes.ai
BACKEND_TIMEOUT_SECS=300
ENABLE_CIRCUIT_BREAKER=false
